:[0,null,null,61829,113460,-147675,4340,-28770,null],"BES":[0,null,null,1696,null,null,4814,44628,-28946],"CAF":[0,null,null,31343,null,-30385,null,null,null],"CPV":[0,null,null,14603,null,-12868,-567,null,920],"GMB":[0,null,null,31709,null,-30356,6568,10843,49086],"GNB":[1,null,null,5744,null,64256,null,null,null],"FSM":[0,null,null,null,37792,null,-17430,-14810,null],"MSR":[0,null,null,null,2662,null,null,null,null],"PSE":[0,null,null,null,11916,-11197,null,null,null],"WLF":[0,null,null,null,2037,null,null,null,null],"MNP":[0,null,null,null,null,null,6000,null,null],"TUV":[0,null,null,null,null,null,71653,null,null],"NFK":[0,null,null,null,null,null,null,7972,null],"ATF":[0,null,null,null,null,null,null,null,41284],"BLM":[0,null,null,null,null,null,null,null,4616],"SMR":[0,null,null,null,null,null,null,null,664]},"notes":{"TWN":"BACI 沒有台灣自己的申報（聯合國不發布台灣的貿易統計），台灣的進口是各出口國申報出口到台灣的數字，經香港等地轉運的貨，出口國常記成出口到轉運地（BACI 也不計香港的轉口）。財政部的海關統計（依原產地）的半導體設備進口：2024 年 216 億美元（比 BACI 多 13%）、2023 年 223 億美元（比 BACI 多 18%）","HKG":"香港是轉口港，BACI 不計香港的轉口（2024 年香港的半導體設備出口只有 1.8 億美元），經香港轉往中國大陸等地的貨都記在香港的進口","CHN":"經香港轉進來的貨記在香港的進口；2024 年中國大陸加香港是 502 億美元"},"notesEn":{"TWN":"BACI has no reports from Taiwan itself (the UN does not publish Taiwan's trade statistics): Taiwan's imports are what exporting countries recorded as shipped to Taiwan, and goods sent via Hong Kong or other hubs are often recorded as going to the hub (BACI also leaves out Hong Kong's re-exports). Taiwan's Ministry of Finance customs statistics (by origin) show semiconductor equipment imports of US$21.6 billion in 2024 (13% more than BACI) and US$22.3 billion in 2023 (18% more than BACI)","HKG":"Hong Kong is an entrepôt, and BACI leaves out its re-exports (Hong Kong's semiconductor equipment exports in 2024 were only US$178 million), so goods passing through Hong Kong to mainland China and elsewhere are counted as Hong Kong's imports","CHN":"Goods arriving via Hong Kong are counted as Hong Kong's imports; mainland China and Hong Kong together imported US$50.2 billion in 2024"}}