WLF":[0,null,764,23,null,null,null,null,null],"NFK":[0,null,null,511,null,null,null,null,null],"SLB":[0,null,null,6942,-1793,-3112,-647,null,null],"SPM":[0,null,null,4439,null,null,null,-1230,null],"TKL":[0,null,null,1889,null,null,null,null,null],"BES":[0,null,null,null,2431,null,4341,-2910,-2627],"FLK":[0,null,null,null,null,3953,null,2463,null],"NIU":[0,null,null,null,null,1034,null,null,null],"NRU":[0,null,null,null,null,9588,-7149,27630,-26795],"ATF":[0,null,null,null,null,null,null,null,1067]},"notes":{"TWN":"BACI 沒有台灣自己的申報（聯合國不發布台灣的貿易統計），台灣的進口是各出口國申報出口到台灣的數字，經香港等地轉運的貨，出口國常記成出口到轉運地（BACI 也不計香港的轉口）。財政部的海關統計（依原產地）的電容器進口：2024 年 21.4 億美元（比 BACI 多 3%）、2023 年 16.4 億美元（比 BACI 多 5%）","HKG":"香港是轉口港，BACI 不計香港的轉口（2024 年香港的電容器出口只有 7.2 億美元），經香港轉往中國大陸等地的貨都記在香港的進口","CHN":"經香港轉進來的貨記在香港的進口；2024 年中國大陸加香港是 107 億美元"},"notesEn":{"TWN":"BACI has no reports from Taiwan itself (the UN does not publish Taiwan's trade statistics): Taiwan's imports are what exporting countries recorded as shipped to Taiwan, and goods sent via Hong Kong or other hubs are often recorded as going to the hub (BACI also leaves out Hong Kong's re-exports). Taiwan's Ministry of Finance customs statistics (by origin) show capacitor imports of US$2.1 billion in 2024 (3% more than BACI) and US$1.6 billion in 2023 (5% more than BACI)","HKG":"Hong Kong is an entrepôt, and BACI leaves out its re-exports (Hong Kong's capacitor exports in 2024 were only US$717 million), so goods passing through Hong Kong to mainland China and elsewhere are counted as Hong Kong's imports","CHN":"Goods arriving via Hong Kong are counted as Hong Kong's imports; mainland China and Hong Kong together imported US$10.7 billion in 2024"}}