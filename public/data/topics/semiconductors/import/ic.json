612,-99207,12607,-30298],"ZAF":[4,17189,529,-5148,-857,4311,6045,-4014,-5288],"ZMB":[2,13244,-5433,-573,1868,-2726,2021,1246,-961],"ZWE":[2,3106,9309,703,-935,-695,6965,1339,-546],"MSR":[0,null,12000,1460,-9270,2095,-3638,36664,-33407],"NFK":[0,null,4749,4175,16734,-15861,7496,null,null],"NIU":[0,null,528,32472,null,193073,null,-223140,59617],"SSD":[1,null,24478,-11224,-9865,-888,1394,782,-2427],"TUV":[0,null,1322,null,null,null,309228,-305529,669915],"CXR":[0,null,null,16846,-14612,820,10981,-13433,15376],"TKL":[2,null,null,15216,null,null,null,13013,-11136]},"notes":{"TWN":"BACI 沒有台灣自己的申報（聯合國不發布台灣的貿易統計），台灣的進口是各出口國申報出口到台灣的數字，經香港等地轉運的貨，出口國常記成出口到轉運地（BACI 也不計香港的轉口）。財政部的海關統計（依原產地）的積體電路進口：2024 年 943 億美元（比 BACI 多 29%）、2023 年 732 億美元（比 BACI 多 38%）","HKG":"香港是轉口港，BACI 不計香港的轉口（2024 年香港的積體電路出口只有 123 億美元），經香港轉往中國大陸等地的貨都記在香港的進口","CHN":"經香港轉進來的貨記在香港的進口；2024 年中國大陸加香港是 3,910 億美元"},"notesEn":{"TWN":"BACI has no reports from Taiwan itself (the UN does not publish Taiwan's trade statistics): Taiwan's imports are what exporting countries recorded as shipped to Taiwan, and goods sent via Hong Kong or other hubs are often recorded as going to the hub (BACI also leaves out Hong Kong's re-exports). Taiwan's Ministry of Finance customs statistics (by origin) show IC imports of US$94.3 billion in 2024 (29% more than BACI) and US$73.2 billion in 2023 (38% more than BACI)","HKG":"Hong Kong is an entrepôt, and BACI leaves out its re-exports (Hong Kong's IC exports in 2024 were only US$12.3 billion), so goods passing through Hong Kong to mainland China and elsewhere are counted as Hong Kong's imports","CHN":"Goods arriving via Hong Kong are counted as Hong Kong's imports; mainland China and Hong Kong together imported US$391.0 billion in 2024"}}