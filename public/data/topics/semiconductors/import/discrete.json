,-376,35],"GUM":[0,null,570,122696,-107532,null,-13311,8858,-8843],"MSR":[0,null,1335,null,48272,44818,-87225,55781,-24496],"NRU":[0,null,13873,null,null,-887,13202,11103,null],"PLW":[0,null,14957,null,-7401,15563,-16909,-1637,-2768],"PSE":[0,null,2131,null,2208,-362,4822,-4642,null],"SHN":[0,null,905,null,16514,44281,31606,-78651,3095],"SSD":[0,null,358501,-197317,-103464,-4454,16937,-25456,-37780],"TKL":[0,null,99528,null,-98463,null,null,null,null],"CCK":[0,null,null,null,6552,408,-2619,null,null],"PCN":[0,null,null,null,2098,null,null,null,null],"MNP":[0,null,null,null,null,5769,null,null,null],"TUV":[1,null,null,null,null,5829,23585,-12245,-1998],"NFK":[0,null,null,null,null,null,68187,null,-66547]},"notes":{"TWN":"BACI 沒有台灣自己的申報（聯合國不發布台灣的貿易統計），台灣的進口是各出口國申報出口到台灣的數字，經香港等地轉運的貨，出口國常記成出口到轉運地（BACI 也不計香港的轉口）。財政部的海關統計（依原產地）的分離式半導體進口：2024 年 15.0 億美元（比 BACI 多 9%）、2023 年 14.7 億美元（比 BACI 多 6%）","HKG":"香港是轉口港，BACI 不計香港的轉口（2024 年香港的分離式半導體出口只有 6.1 億美元），經香港轉往中國大陸等地的貨都記在香港的進口","CHN":"經香港轉進來的貨記在香港的進口；2024 年中國大陸加香港是 180 億美元"},"notesEn":{"TWN":"BACI has no reports from Taiwan itself (the UN does not publish Taiwan's trade statistics): Taiwan's imports are what exporting countries recorded as shipped to Taiwan, and goods sent via Hong Kong or other hubs are often recorded as going to the hub (BACI also leaves out Hong Kong's re-exports). Taiwan's Ministry of Finance customs statistics (by origin) show discrete semiconductor imports of US$1.5 billion in 2024 (9% more than BACI) and US$1.5 billion in 2023 (6% more than BACI)","HKG":"Hong Kong is an entrepôt, and BACI leaves out its re-exports (Hong Kong's discrete semiconductor exports in 2024 were only US$609 million), so goods passing through Hong Kong to mainland China and elsewhere are counted as Hong Kong's imports","CHN":"Goods arriving via Hong Kong are counted as Hong Kong's imports; mainland China and Hong Kong together imported US$18.0 billion in 2024"}}